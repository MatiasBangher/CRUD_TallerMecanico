@page "/error-vehiculo"
<div class="modal fade show mt-5" style="display: block; position: absolute; right: 20px;" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Información del Vehículo</h5>
                <a class="close custom-close" href="/vehiculos">
                    <span>&times;</span>
                </a>
            </div>
            <div class="modal-body">
                <p class="modal-text"><strong>Lo lamentamos, no existe vehículo con esta patente</strong></p>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-close {
        font-size: 2rem; /* Tamaño del texto */
        color: red; /* Color rojo */
        text-decoration: none; /* Sin subrayado */
    }

        .custom-close:hover {
            color: darkred; /* Color más oscuro al pasar el mouse */
        }

        .custom-close span {
            display: inline-block;
            font-weight: bold;
        }

    /* Estilo para el texto del modal */
    .modal-text {
        font-size: 1.5rem; /* Cambia este valor para ajustar el tamaño */
        text-align: center; /* Centra el texto */
    }
</style>